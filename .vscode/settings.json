{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist-ssr": true,
    "**/.artifacts": true,
    "**/coverage": true,
    "**/test-results*": true,
    "**/playwright-report": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-ssr/**": true,
    "**/.artifacts/**": true,
    "**/coverage/**": true,
    "**/test-results*/**": true,
    "**/playwright-report/**": true,
    "**/__pycache__/**": true
  }
}
