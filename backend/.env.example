# LOCAL uses loopback only. PRE and PROD require distinct identities.
ATLAS_ENV=local

﻿PORT=3000
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: usage accounting and canonical services.
SUPABASE_SECRET_KEY=
SUPABASE_ASSESSMENT_DATABASE_URL=
GEMINI_API_KEY=
# Optional credential pool. Keys in the same Google project share limits.
# Keep provider limits intact. Separate credentials with commas or newlines.
GEMINI_API_KEYS=
GEMINI_MODEL_WORD=gemini-3.5-flash-lite
GEMINI_MODEL_CHAT=gemini-3.8-flash


# Hosted builds receive the PRE/PROD identity matrix from the process environment.
ATLAS_HOSTED_IDENTITIES=
