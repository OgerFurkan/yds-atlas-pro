# Browser-safe values only. Never put a secret/service-role or Gemini key here.
VITE_ATLAS_ENV=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave empty for the same-origin /api proxy.
VITE_API_URL=


# Hosted builds receive the PRE/PROD identity matrix from the process environment.
ATLAS_HOSTED_IDENTITIES=
