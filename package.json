{
  "name": "yds-atlas-pro",
  "private": true,
  "packageManager": "bun@1.3.5",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd=frontend dev",
    "dev:api": "bun run --cwd=backend dev",
    "build": "bun run --cwd=frontend build && bun run typecheck:api",
    "build:test": "bun run --cwd=frontend build --mode local-e2e --outDir node_modules/.atlas-e2e-preview && bun run typecheck:api",
    "lint": "bun run --cwd=frontend lint && bun run lint:api",
    "test": "bun --no-env-file test tests/backend tests/frontend/unit",
    "test:coverage": "bun --no-env-file test --coverage --coverage-dir=.artifacts/coverage tests/backend tests/frontend/unit",
    "test:node": "node --test \"tests/**/*.node.test.mjs\"",
    "test:e2e": "bun run --cwd=frontend test:e2e",
    "test:inspector": "bun run --cwd=frontend playwright test --config config/playwright/inspector.config.ts",
    "test:demo": "bun run --cwd=frontend playwright test --config config/playwright/demo.config.ts",
    "test:dev": "bun run --cwd=frontend test:dev",
    "test:fixtures": "bun run --cwd=frontend playwright test --config config/playwright/fixtures.config.ts",
    "format": "bun run format:check --write",
    "format:check": "biome format .",
    "check": "biome check .",
    "lint:api": "bun run --cwd=backend lint",
    "test:unit": "bun run --cwd=frontend test",
    "test:api": "bun run --cwd=backend test",
    "typecheck:api": "bun run --cwd=backend typecheck",
    "test:cloud": "bun run --cwd=frontend test:cloud",
    "typecheck": "node scripts/quality/typecheck.mjs frontend && bun run typecheck:api",
    "quality:quick": "node scripts/quality/run.mjs quick",
    "quality:local": "node scripts/quality/run.mjs local",
    "quality:services": "node scripts/quality/run.mjs services",
    "quality:release": "node scripts/quality/run.mjs release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@electric-sql/pglite": "0.5.16",
    "supabase": "3.1.0"
  }
}
